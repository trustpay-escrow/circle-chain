# CircleChain Backend Environment Configuration Sample

PORT=4000

# PostgreSQL Database Configuration (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/circlechain?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# Stellar / Soroban Network Configuration
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Deployed Contract Address
CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
