# ==============================================================================
# CircleChain Enterprise Backend - Environment Configuration
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration (Prisma ORM with PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/circlechain?schema=public"

# Structured Logging & Observability
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Redis Cache & Background Queue
REDIS_URL="redis://localhost:6379"

# Stellar / Soroban Network Configuration
# Options: TESTNET, PUBLIC, LOCAL
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# Deployed Soroban Smart Contract ID
CONTRACT_ID="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# CORS Security Allowed Origins (Comma-separated or wildcard '*')
CORS_ORIGIN="*"
