{
  "name": "circle-chain-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "Production-Grade Non-Custodial ROSCA Savings Protocol on Stellar & Soroban",
  "scripts": {
    "test": "npm --prefix backend test",
    "test:backend": "npm --prefix backend test",
    "test:contracts": "cd contracts && cargo test",
