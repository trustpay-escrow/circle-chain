# =====================================================================
# CircleChain Monorepo Environment Configuration Template
# =====================================================================
# Copy this file to:
#   - backend/.env
#   - frontend/.env.local
# =====================================================================

# ---------------------------------------------------------------------
# Backend Service Configuration (Express + Prisma ORM)
# ---------------------------------------------------------------------
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/circlechain?schema=public"
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------
# Stellar Network & Soroban RPC Endpoints
# ---------------------------------------------------------------------
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Deployed Soroban Smart Contract Address (matches target wasm deployment)
CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ---------------------------------------------------------------------
# Frontend Application Configuration (Next.js 14)
# ---------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
